{
  "title": "OneDecision architecture",
  "subtitle": "One agent may propose. Deterministic code decides, acts, and records. A person teaches the rule.",
  "note": "Every tier below is in this repository. Two domains ship on it: returns, and accounts-payable invoice variance. Business systems are simulated adapters, not production integrations.",
  "tiers": [
    {
      "id": "surfaces",
      "name": "Surfaces",
      "role": "How work arrives, and where a person acts on it",
      "nodes": [
        {
          "id": "event",
          "name": "Returns-dock check-in",
          "meta": "POST /events/{case_id}",
          "functions": [
            "An event from the dock, not a chat prompt",
            "Six demo cases, one per boundary"
          ]
        },
        {
          "id": "agentcore",
          "name": "AgentCore Runtime",
          "meta": "POST /invocations \u00b7 us-west-2",
          "functions": [
            "The same handler, deployed to AWS",
            "Returns the decision card as JSON"
          ]
        },
        {
          "id": "web",
          "name": "Web app",
          "meta": "Inbox \u00b7 Decision \u00b7 Policies \u00b7 Dashboard",
          "functions": [
            "Where a supervisor reads and decides",
            "Phone, tablet, desktop"
          ]
        }
      ]
    },
    {
      "id": "reasoning",
      "name": "Model reasoning",
      "role": "May propose. May never act.",
      "nodes": [
        {
          "id": "agent",
          "name": "One Strands agent",
          "meta": "investigate \u00b7 card \u00b7 propose",
          "functions": [
            "Three invocations, one agent",
            "Typed output, re-derived downstream"
          ]
        },
        {
          "id": "provider",
          "name": "Model provider",
          "meta": "bedrock | anthropic | scripted",
          "functions": [
            "Claude Opus 5 on Bedrock, prompt cached",
            "Offline scripted model for tests and CI"
          ]
        },
        {
          "id": "tools",
          "name": "Read-only tools",
          "meta": "five, all side-effect free",
          "functions": [
            "get_return_case \u00b7 find_approved_policy",
            "compare_expected_and_received",
            "lookup_replacement_cost \u00b7 replay (dry run)"
          ]
        }
      ]
    },
    {
      "id": "control",
      "name": "Control plane",
      "role": "Deterministic. The only thing that acts.",
      "nodes": [
        {
          "id": "orchestrator",
          "name": "Orchestrator",
          "meta": "handle_event \u00b7 approve_and_teach",
          "functions": [
            "Runs the golden path end to end",
            "The only code that changes anything"
          ]
        },
        {
          "id": "facts",
          "name": "Facts and reconciliation",
          "meta": "derive_facts",
          "functions": [
            "Re-derives every fact from source",
            "The agent's report stays advisory"
          ]
        },
        {
          "id": "guardrails",
          "name": "Hard guardrails",
          "meta": "non-overridable",
          "functions": [
            "Run before any policy is consulted",
            "Serial, damage, safety-critical, evidence"
          ]
        },
        {
          "id": "engine",
          "name": "Policy engine",
          "meta": "data, never code",
          "functions": [
            "Evaluates active policy versions",
            "No dynamic execution, ever"
          ]
        },
        {
          "id": "execute",
          "name": "Execute and verify",
          "meta": "idempotency key per action",
          "functions": [
            "Work order, disposition, close",
            "Reads every write back before closing"
          ]
        },
        {
          "id": "domains",
          "name": "Domain packs",
          "meta": "returns \u00b7 ap.invoice_variance",
          "functions": [
            "Facts, guardrails, actions, corpus",
            "A second domain changed no machinery"
          ]
        }
      ]
    },
    {
      "id": "governance",
      "name": "Governance",
      "role": "How one decision becomes a rule",
      "nodes": [
        {
          "id": "card",
          "name": "Decision card",
          "meta": "one decision, thirty seconds",
          "functions": [
            "Evidence, with the tool that produced it",
            "Proposed boundaries and open questions"
          ]
        },
        {
          "id": "human",
          "name": "Supervisor",
          "meta": "approve \u00b7 activate",
          "functions": [
            "Approving records a decision only",
            "Activation is a separate, explicit act"
          ]
        },
        {
          "id": "candidate",
          "name": "Candidate policy",
          "meta": "schema-validated, inert",
          "functions": [
            "Conditions from a nine-field allowlist",
            "Action set fixed by the system"
          ]
        },
        {
          "id": "replay",
          "name": "Replay gate",
          "meta": "24 labeled historical cases",
          "functions": [
            "One wrong action blocks activation",
            "Re-run server-side at activation"
          ]
        },
        {
          "id": "active",
          "name": "Active policy version",
          "meta": "versioned \u00b7 diffed \u00b7 retirable",
          "functions": [
            "Activated by a person with a token",
            "A revision may narrow, never widen"
          ]
        }
      ]
    },
    {
      "id": "records",
      "name": "Systems of record",
      "role": "Synthetic business systems, real evidence",
      "nodes": [
        {
          "id": "returns",
          "name": "Returns system",
          "meta": "synthetic \u00b7 read-only",
          "functions": [
            "Cases, bill of materials, evidence"
          ]
        },
        {
          "id": "parts",
          "name": "Parts catalog",
          "meta": "synthetic \u00b7 read-only",
          "functions": [
            "Replacement cost and stock status"
          ]
        },
        {
          "id": "wms",
          "name": "Warehouse",
          "meta": "synthetic \u00b7 writes",
          "functions": [
            "Work orders and dispositions",
            "Every write takes an idempotency key"
          ]
        },
        {
          "id": "audit",
          "name": "Audit log",
          "meta": "append-only \u00b7 hash-chained",
          "functions": [
            "Every event, tool call, approval, action",
            "The database refuses UPDATE and DELETE"
          ]
        },
        {
          "id": "db",
          "name": "Database",
          "meta": "SQLite or PostgreSQL",
          "functions": [
            "One schema, versioned migrations"
          ]
        },
        {
          "id": "apledger",
          "name": "AP ledger",
          "meta": "synthetic \u00b7 second domain",
          "functions": [
            "Invoices, vendors, adjustments"
          ]
        }
      ]
    }
  ],
