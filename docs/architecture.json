{
  "title": "OneDecision architecture",
  "subtitle": "One agent may propose. Deterministic code decides, acts, and records. A person teaches the rule.",
  "note": "Every tier below is in this repository. Synthetic business systems are simulated adapters, not production integrations.",
  "tiers": [
    {
      "id": "surfaces",
      "name": "Surfaces",
      "role": "How work arrives, and where a person acts on it",
      "nodes": [
        {
          "id": "event",
          "name": "Returns-dock check-in",
          "meta": "POST /events/{case_id}",
          "functions": [
            "An event from the dock, not a chat prompt",
            "Six demo cases, one per boundary"
          ]
        },
        {
          "id": "agentcore",
          "name": "AgentCore Runtime",
          "meta": "POST /invocations · us-west-2",
          "functions": [
            "The same handler, deployed to AWS",
            "Returns the decision card as JSON"
          ]
        },
        {
          "id": "web",
          "name": "Web app",
          "meta": "Inbox · Decision · Policies · Dashboard",
          "functions": [
            "Where a supervisor reads and decides",
            "Phone, tablet, desktop"
          ]
        }
      ]
    },
    {
      "id": "reasoning",
      "name": "Model reasoning",
      "role": "May propose. May never act.",
      "nodes": [
        {
          "id": "agent",
          "name": "One Strands agent",
          "meta": "investigate · card · propose",
          "functions": [
            "Three invocations, one agent",
            "Typed output, re-derived downstream"
          ]
        },
        {
          "id": "provider",
          "name": "Model provider",
          "meta": "bedrock | anthropic | scripted",
          "functions": [
            "Claude Opus 5 on Bedrock, prompt cached",
            "Offline scripted model for tests and CI"
          ]
        },
        {
          "id": "tools",
          "name": "Read-only tools",
          "meta": "five, all side-effect free",
          "functions": [
            "get_return_case · find_approved_policy",
            "compare_expected_and_received",
            "lookup_replacement_cost · replay (dry run)"
          ]
        }
      ]
    },
    {
      "id": "control",
      "name": "Control plane",
      "role": "Deterministic. The only thing that acts.",
      "nodes": [
        {
          "id": "orchestrator",
          "name": "Orchestrator",
          "meta": "handle_event · approve_and_teach",
          "functions": [
            "Runs the golden path end to end",
            "The only code that changes anything"
          ]
        },
        {
          "id": "facts",
          "name": "Facts and reconciliation",
          "meta": "derive_facts",
          "functions": [
            "Re-derives every fact from source",
            "The agent's report stays advisory"
          ]
        },
        {
          "id": "guardrails",
          "name": "Hard guardrails",
          "meta": "non-overridable",
          "functions": [
            "Run before any policy is consulted",
            "Serial, damage, safety-critical, evidence"
          ]
        },
        {
          "id": "engine",
          "name": "Policy engine",
          "meta": "data, never code",
          "functions": [
            "Evaluates active policy versions",
            "No dynamic execution, ever"
          ]
        },
        {
          "id": "execute",
          "name": "Execute and verify",
          "meta": "idempotency key per action",
          "functions": [
            "Work order, disposition, close",
            "Reads every write back before closing"
          ]
        }
      ]
    },
    {
      "id": "governance",
      "name": "Governance",
      "role": "How one decision becomes a rule",
      "nodes": [
        {
          "id": "card",
          "name": "Decision card",
          "meta": "one decision, thirty seconds",
          "functions": [
            "Evidence, with the tool that produced it",
            "Proposed boundaries and open questions"
          ]
        },
        {
          "id": "human",
          "name": "Supervisor",
          "meta": "approve · activate",
          "functions": [
            "Approving records a decision only",
            "Activation is a separate, explicit act"
          ]
        },
        {
          "id": "candidate",
          "name": "Candidate policy",
          "meta": "schema-validated, inert",
          "functions": [
            "Conditions from a nine-field allowlist",
            "Action set fixed by the system"
          ]
        },
        {
          "id": "replay",
          "name": "Replay gate",
          "meta": "24 labeled historical cases",
          "functions": [
            "One wrong action blocks activation",
            "Re-run server-side at activation"
          ]
        },
        {
          "id": "active",
          "name": "Active policy version",
          "meta": "versioned · diffed · retirable",
          "functions": [
            "Activated by a person with a token",
            "A revision may narrow, never widen"
          ]
        }
      ]
    },
    {
      "id": "records",
      "name": "Systems of record",
      "role": "Synthetic business systems, real evidence",
      "nodes": [
        {
          "id": "returns",
          "name": "Returns system",
          "meta": "synthetic · read-only",
          "functions": ["Cases, bill of materials, evidence"]
        },
        {
          "id": "parts",
          "name": "Parts catalog",
          "meta": "synthetic · read-only",
          "functions": ["Replacement cost and stock status"]
        },
        {
          "id": "wms",
          "name": "Warehouse",
          "meta": "synthetic · writes",
          "functions": ["Work orders and dispositions", "Every write takes an idempotency key"]
        },
        {
          "id": "audit",
          "name": "Audit log",
          "meta": "append-only · hash-chained",
          "functions": ["Every event, tool call, approval, action", "The database refuses UPDATE and DELETE"]
        },
        {
          "id": "db",
          "name": "Database",
          "meta": "SQLite or PostgreSQL",
          "functions": ["One schema, versioned migrations"]
        }
      ]
    }
  ],
  "edges": [
    {"from": "event", "to": "orchestrator", "kind": "control", "label": "check-in event", "step": 1},
    {"from": "orchestrator", "to": "agent", "kind": "control", "label": "investigate", "step": 2},
    {"from": "agent", "to": "orchestrator", "kind": "advisory", "label": "typed report, advisory", "step": 3},
    {"from": "orchestrator", "to": "facts", "kind": "control", "label": "re-derive", "step": 4},
    {"from": "facts", "to": "guardrails", "kind": "control", "label": "facts", "step": 5},
    {"from": "guardrails", "to": "engine", "kind": "control", "label": "clear", "step": 6},
    {"from": "engine", "to": "execute", "kind": "control", "label": "a policy matches", "step": 7},
    {"from": "engine", "to": "card", "kind": "control", "label": "no policy applies", "step": 8},

    {"from": "agentcore", "to": "orchestrator", "kind": "control", "label": "invocation"},
    {"from": "web", "to": "orchestrator", "kind": "control", "label": "check in · approve · activate"},
    {"from": "agent", "to": "provider", "kind": "control", "label": "model call"},
    {"from": "agent", "to": "tools", "kind": "control", "label": "tool calls, one at a time"},
    {"from": "tools", "to": "returns", "kind": "read", "label": "case, BOM, evidence"},
    {"from": "tools", "to": "parts", "kind": "read", "label": "replacement cost"},
    {"from": "tools", "to": "replay", "kind": "control", "label": "dry-run a candidate"},
    {"from": "facts", "to": "returns", "kind": "read", "label": "re-read the case"},
    {"from": "facts", "to": "parts", "kind": "read", "label": "re-read the price"},
    {"from": "guardrails", "to": "human", "kind": "escalate", "label": "blocked, so a person decides"},
    {"from": "execute", "to": "wms", "kind": "write", "label": "work order · disposition"},
    {"from": "execute", "to": "human", "kind": "escalate", "label": "verification mismatch"},
    {"from": "card", "to": "human", "kind": "control", "label": "put to a person"},
    {"from": "human", "to": "orchestrator", "kind": "control", "label": "approve and teach"},
    {"from": "orchestrator", "to": "candidate", "kind": "control", "label": "validated proposal"},
    {"from": "candidate", "to": "replay", "kind": "control", "label": "replay before offering"},
    {"from": "replay", "to": "active", "kind": "gate", "label": "zero wrong actions, or no activation"},
    {"from": "human", "to": "active", "kind": "gate", "label": "explicit activation + token"},
    {"from": "active", "to": "engine", "kind": "control", "label": "the next hundred cases"},

    {"from": "orchestrator", "to": "audit", "kind": "audit", "label": "every step"},
    {"from": "tools", "to": "audit", "kind": "audit", "label": "every tool call"},
    {"from": "guardrails", "to": "audit", "kind": "audit", "label": "every block"},
    {"from": "execute", "to": "audit", "kind": "audit", "label": "every action and verification"},
    {"from": "human", "to": "audit", "kind": "audit", "label": "who decided, and when"},
    {"from": "active", "to": "audit", "kind": "audit", "label": "who activated, and when"},
    {"from": "audit", "to": "web", "kind": "read", "label": "timeline · dashboard usage"},

    {"from": "returns", "to": "db", "kind": "store", "label": "tables"},
    {"from": "parts", "to": "db", "kind": "store", "label": "tables"},
    {"from": "wms", "to": "db", "kind": "store", "label": "tables"},
    {"from": "audit", "to": "db", "kind": "store", "label": "append-only table"},
    {"from": "candidate", "to": "db", "kind": "store", "label": "policy store"},
    {"from": "active", "to": "db", "kind": "store", "label": "policy store"}
  ],
  "kinds": {
    "control": {"label": "control flow", "color": "#5eead4"},
    "advisory": {"label": "advisory output", "color": "#9aa4b6"},
    "read": {"label": "read", "color": "#7dd3fc"},
    "write": {"label": "write", "color": "#4ade80"},
    "gate": {"label": "human gate", "color": "#fbbf24"},
    "escalate": {"label": "escalation", "color": "#f87171"},
    "audit": {"label": "audit record", "color": "#6b7488"},
    "store": {"label": "persistence", "color": "#4b5468"}
  }
}
