%% OneDecision — architecture as a mermaid graph, kept by hand.
%% The model behind the rendered views is docs/architecture.json: tools/diagram/
%% build_architecture.py renders docs/architecture.svg (the README image, from which
%% docs/architecture.png is captured at 2x) and docs/architecture.html (the same model,
%% hoverable). This file is a second view of the same system, for reading in a diff.

flowchart TB
    subgraph SYN["SYNTHETIC BUSINESS SYSTEMS (simulated adapters, not production)"]
        RS[["returns system<br/>cases, BOM, evidence"]]
        PC[["parts catalog<br/>replacement cost, stock"]]
        WMS[["warehouse WMS<br/>dispositions, work orders"]]
    end

    EV(["returns-dock check-in event<br/>not a chat prompt<br/>POST /events from the web app"]) --> ORCH
    AC(["Amazon Bedrock AgentCore Runtime<br/>POST /invocations (deployed)"]) --> ORCH

    subgraph REASON["MODEL REASONING — may propose, may never act"]
        AGENT{{"one Strands Agent<br/>investigate · card · propose"}}
        MP["model provider adapter<br/>bedrock | anthropic | scripted"]
        TOOLS["READ-ONLY TOOLS<br/>get_return_case<br/>compare_expected_and_received<br/>lookup_replacement_cost<br/>find_approved_policy<br/>replay_candidate_policy (dry run)"]
        AGENT --- MP
        AGENT --> TOOLS
    end

    subgraph DET["DETERMINISTIC CONTROL PLANE — the only thing that acts"]
        ORCH["orchestrator"]
        FACTS["fact derivation<br/>+ reconciliation"]
        GUARD["hard guardrails<br/>non-overridable"]
        ENGINE["policy engine<br/>data, never code"]
        EXEC["execute_approved_policy<br/>idempotency key"]
        VERIFY["verify_action<br/>read the writes back"]
    end

    subgraph GOV["GOVERNANCE"]
        CARD["decision card"]
        HUMAN(["HUMAN<br/>approve · activate"])
        CAND["candidate policy<br/>schema-validated, inert"]
        REPLAY["replay gate<br/>24 historical cases"]
        ACTIVE[("active policy version")]
        AUDIT[("append-only audit log<br/>hash-chained")]
    end

    ORCH --> AGENT
    TOOLS -.reads.-> RS
    TOOLS -.reads.-> PC
    ORCH --> FACTS
    FACTS -.reads.-> RS
    FACTS -.reads.-> PC
    AGENT -- "typed report (advisory)" --> FACTS
    FACTS --> GUARD
    GUARD -- "blocked" --> ESC(["ESCALATE"])
    GUARD -- "clear" --> ENGINE
    ACTIVE --> ENGINE
    ENGINE -- "no policy applies" --> CARD
    ENGINE -- "match" --> EXEC
    EXEC --> WMS
    EXEC --> VERIFY
    VERIFY -- "fail" --> ESC
    VERIFY -- "pass" --> DONE(["RESOLVED"])

    CARD --> HUMAN
    HUMAN -- "Approve and Teach" --> AGENT
    AGENT -- "typed proposal" --> CAND
    CAND --> REPLAY
    REPLAY -- "any false action" --> BLOCK(["ACTIVATION BLOCKED"])
    REPLAY -- "clean" --> HUMAN
    HUMAN -- "explicit activation + token" --> ACTIVE

    ORCH -.-> AUDIT
    TOOLS -.-> AUDIT
    GUARD -.-> AUDIT
    EXEC -.-> AUDIT
    VERIFY -.-> AUDIT
    HUMAN -.-> AUDIT
    ACTIVE -.-> AUDIT

    subgraph RUN["RUNS ON — same agent and control plane; only provider and transport change"]
        BR[("Amazon Bedrock<br/>Claude Opus 5, us. inference profile")]
        UI["web app<br/>Inbox · Decision · Policies & Audit · Dashboard<br/>phone, tablet, desktop"]
        OFF["offline scripted model<br/>no credentials: tests, CI, judges"]
    end

    MP -.-> BR
    MP -.-> OFF
    HUMAN --- UI
    AUDIT -.->|"agent.run usage: tokens, time, tool calls"| UI
