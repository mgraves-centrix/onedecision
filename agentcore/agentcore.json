{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "OneDecision",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "OneDecision"
  },
  "runtimes": [
    {
      "name": "onedecision",
      "description": "OneDecision returns-exception agent: Strands Agents on Claude Opus 5 via Amazon Bedrock",
      "build": "CodeZip",
      "entrypoint": "agentcore_main.py",
      "codeLocation": ".",
      "runtimeVersion": "PYTHON_3_13",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "ONEDECISION_MODEL_PROVIDER",
          "value": "bedrock"
        },
        {
          "name": "ONEDECISION_BEDROCK_MODEL_ID",
          "value": "us.anthropic.claude-opus-5"
        },
        {
          "name": "ONEDECISION_DB_PATH",
          "value": "/tmp/onedecision.db"
        }
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}
